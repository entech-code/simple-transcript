{
  "manifest_version": 3,
  "name": "Simple Transcript – Copy & Save for Google Meet",
  "short_name": "Simple Transcript",
  "version": "2.25.0",
  "description": "Live Google Meet transcription with speaker names. Copy or save any call.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["dist/content-bridge.js", "dist/caption-observer.js", "dist/floating-popup.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["dist/interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Simple Transcript"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
